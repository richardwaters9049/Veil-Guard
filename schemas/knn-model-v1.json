{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Veil Guard experimental exact KNN JSON model v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "feature_schema",
    "feature_names",
    "label_encoding",
    "status",
    "model_id",
    "corpus_source_sha256",
    "protocol_sha256",
    "training_partition",
    "k",
    "weights",
    "mean",
    "scale",
    "raw_min",
    "raw_max",
    "policy",
    "references"
  ],
  "properties": {
    "schema": {
      "const": "veilguard.knn-model.v1"
    },
    "feature_schema": {
      "const": "veilguard.features.v1"
    },
    "feature_names": {
      "const": [
        "log_length",
        "shannon_entropy",
        "digit_ratio",
        "uppercase_ratio",
        "symbol_ratio",
        "keyword_proximity",
        "sensitive_assignment",
        "placeholder_similarity"
      ]
    },
    "label_encoding": {
      "const": {
        "0": "benign_fixture",
        "1": "sensitive_candidate"
      }
    },
    "status": {
      "const": "experimental_research_only"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "corpus_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "protocol_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "training_partition": {
      "const": "train"
    },
    "k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "weights": {
      "enum": [
        "inverse_distance",
        "uniform"
      ]
    },
    "mean": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "number"
      }
    },
    "scale": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "raw_min": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "number"
      }
    },
    "raw_max": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "number"
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_all",
        "margin",
        "distance_limit",
        "selection_status"
      ],
      "properties": {
        "review_all": {
          "type": "boolean"
        },
        "margin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "distance_limit": {
          "type": "number",
          "minimum": 0
        },
        "selection_status": {
          "enum": [
            "validation_selected",
            "coverage_or_error_target_unmet",
            "baseline_fixed"
          ]
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "vector"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "label": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "vector": {
            "type": "array",
            "minItems": 8,
            "maxItems": 8,
            "items": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
